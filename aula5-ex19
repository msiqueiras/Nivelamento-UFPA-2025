# FAÇA UM PROGRAMA QUE PERMITE ADICIONAR, REMOVER E VISUALIZAR ELEMENTOS DE UMA LISTA DE FORMA INDETERMINADA COM UMA CONDIÇÃO DE PARADA.  
lista = [1, 3.1415, 0, 92, 121, 450, 3000, -39.8, -1.3333333]
tamanho_lista = 0
for n in lista:
    tamanho_lista += 1
print('Lista:', lista)
continuar = 0
while continuar == 0:  
    print('MENU DE OPÇÕES') 
    print('Adicionar novo item.....[1]')
    print('Remover item............[2]')
    print('Visualizar item.........[3]')
    resp = int(input('Digite o número da ação que deseja fazer com a lista:'))
    if resp == 1:
        lista.append(int(input('Digite um número:')))
        print('Lista atualizada:', lista)
    elif resp == 2:
        indice = int(input('Índice do elemento a ser removido:'))
        if 0 <= indice and indice <= tamanho_lista:
            lista.pop(indice)
            print('Lista atualizada:', lista)
        else:
            print('Índice inválido')
    elif resp == 3:
        indice = int(input('Índice do elemento a ser visualizado:'))
        if 0 <= indice and indice <= tamanho_lista:
            print(f'Elemento de índice {indice}: {lista[indice]}')
        else:
            print('Índice inválido')
    else:
        print('Digite uma resposta válida')
    continuar = int(input('Digite 0 para continuar:'))
print('Encerrando programa...')
