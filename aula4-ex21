#FAÇA UM PROGRAMA QUE RECEBA 5 NÚMEROS E EXIBA ELES DE FORMA ORDENADA (CRESCENTE).
lista = []
for x in range(4):
    lista.append(int(input(f'Digite o {x+1}º número inteiro:')))
print('Lista desordenada:', lista)
