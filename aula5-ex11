#FAZER UM LAÇO QUE ARMAZENE 10 NÚMEROS EM UMA LISTA. RETORNE A SOMA DE TODOS OS NÚMEROS DE ÍNDICE PAR.
lista = []
soma_pares = 0
indice = 0
for x in range(1, 11):
    numero = int(input(f'Digite o {x}º número inteiro:'))
    lista.append(numero)
    if indice % 2 == 0:
        soma_pares += numero
    indice += 1
print('Lista:', lista)
print('Soma dos números de índice par:', soma_pares)
