#MULTIPLIQUE TODOS OS ELEMENTOS DE UMA LISTA POR UM NÚMERO DE ESCOLHA DO USUÁRIO.
lista = []
continuar = 1
while continuar == 1:
    lista.append(float(input('Digite um número:')))
    continuar = int(input('Digite 1 para continuar adicionando números:'))
print(f'A lista original é: {lista}')
mult = float(input('Digite o fator de multiplicação:'))
lista_multiplicada = []
for n in lista:
    lista_multiplicada.append(n*mult)
print(f'A lista multiplicada por {mult} é: {lista_multiplicada}')
