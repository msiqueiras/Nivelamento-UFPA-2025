#DADA UMA LISTA DE NÚMEROS, PEÇA AO USUÁRIO UM NÚMERO N E EXIBA APENAS OS NÚMEROS MAIORES QUE N PRESENTES NA LISTA.
lista_num = []
lista_maiores = []
tamanho_maiores = 0
continuar = 1
while continuar == 1:
    lista_num.append(float(input('Adicione um número:')))
    continuar = int(input('Digite 1 para continuar:'))
numero = int(input('Digite um número para ser analisado:'))
for n in lista_num:
    if n > numero:
        lista_maiores.append(n)
        tamanho_maiores += 1
if tamanho_maiores > 0:
    print(f'Números maiores que {numero}:', end=' ')
    for x in lista_maiores:
        print(x, ',', end=' ')
    print('FIM')
else:
    print(f'Não há números nessa lista que são maiores que {numero}')
