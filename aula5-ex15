# DADA UMA LISTA DE NÚMEROS FORNECIDA PELO USUÁRIO, CRIE E EXIBA UMA LISTA APENAS COM OS NÚMEROS PRIMOS.
lista = []
primos = []
continuar = 1
tamanho_primos = 0
while continuar == 1: # Bloco que cria um acréscimo a nossa lista inicial e que verifica se o usuário quer ou não continuar
    lista.append(int(input('Digite um número inteiro:')))
    continuar = int(input('Digite 1 para adicionar outro número:'))
for num in lista:
    if num >= 2: # os números zero e um não são primos
        contador_de_divisores = 0
        for divisor in range(1, num+1): # Verifica se os números naquele intervalo são divisores de número analisado
            if num % divisor == 0:
                contador_de_divisores += 1 
            if contador_de_divisores == 2: # Os números primos só possuem dois divisores, o número um e ele mesmo
                primos.append(num)
                tamanho_primos += 1
print('Lista:', lista)
if tamanho_primos > 0:
    print('Lista de primos:', primos)
else:
    print('Não há números primos na lista')
